# Sao chep thanh .env va sua lai cho may cua ban. KHONG commit file .env.
# Mau cau hinh de TV4 tu viet Settings; chua co code doc environment.
# JWT/rates ben duoi la baseline cho BE-01/TR-01; chua duoc engine su dung.

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stock_exchange
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stock_exchange

# --- Bao mat ---
# Sinh khoa:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=thay-bang-chuoi-ngau-nhien
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Ung dung ---
PROJECT_NAME=StockMate API
API_V1_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

# CORS: origin cua app Flutter khi chay web/dev
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Baseline luat dich: docs/BUSINESS_RULES.md; engine chua trien khai ---
TRANSACTION_FEE_RATE=0.0015
SELL_TAX_RATE=0.001
SETTLEMENT_DAYS=2
